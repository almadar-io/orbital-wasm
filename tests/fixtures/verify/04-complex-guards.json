{
  "name": "Complex Guards Test",
  "description": "S-expression guard evaluation with nested conditions",
  "version": "1.0.0",
  "orbitals": [
    {
      "name": "Loan Application",
      "entity": {
        "name": "LoanApplication",
        "collection": "loan_applications",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "primaryKey": true
          },
          {
            "name": "applicantName",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          },
          {
            "name": "requestedAmount",
            "type": "number",
            "required": true
          },
          {
            "name": "annualIncome",
            "type": "number",
            "required": true
          },
          {
            "name": "creditScore",
            "type": "number",
            "required": true
          },
          {
            "name": "employmentYears",
            "type": "number",
            "required": true
          },
          {
            "name": "existingDebt",
            "type": "number",
            "default": 0
          },
          {
            "name": "status",
            "type": "enum",
            "values": ["draft", "submitted", "under_review", "approved", "rejected", "disbursed"],
            "default": "draft"
          },
          {
            "name": "approvedAmount",
            "type": "number"
          },
          {
            "name": "interestRate",
            "type": "number"
          },
          {
            "name": "rejectionReason",
            "type": "string"
          },
          {
            "name": "reviewNotes",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "timestamp",
            "default": "@now"
          },
          {
            "name": "submittedAt",
            "type": "timestamp"
          },
          {
            "name": "decidedAt",
            "type": "timestamp"
          }
        ]
      },
      "traits": [
        {
          "name": "LoanProcessing",
          "category": "lifecycle",
          "linkedEntity": "LoanApplication",
          "emits": [
            { "event": "INIT", "scope": "internal" }
          ],
          "stateMachine": {
            "states": [
              {
                "name": "listing",
                "isInitial": true
              },
              {
                "name": "creating"
              },
              {
                "name": "reviewing"
              },
              {
                "name": "deciding"
              }
            ],
            "events": [
              {
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "key": "CREATE",
                "name": "New Application"
              },
              {
                "key": "SAVE",
                "name": "Save",
                "payloadSchema": [
                  { "name": "data", "type": "object" },
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "SUBMIT",
                "name": "Submit",
                "payloadSchema": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "REVIEW",
                "name": "Start Review",
                "payloadSchema": [
                  { "name": "row", "type": "object" }
                ]
              },
              {
                "key": "AUTO_APPROVE",
                "name": "Auto Approve",
                "payloadSchema": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "AUTO_REJECT",
                "name": "Auto Reject",
                "payloadSchema": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "MANUAL_APPROVE",
                "name": "Manual Approve"
              },
              {
                "key": "MANUAL_REJECT",
                "name": "Manual Reject"
              },
              {
                "key": "DISBURSE",
                "name": "Disburse Funds",
                "payloadSchema": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "BACK",
                "name": "Back"
              },
              {
                "key": "CANCEL",
                "name": "Cancel"
              }
            ],
            "transitions": [
              {
                "from": "listing",
                "to": "listing",
                "event": "INIT",
                "effects": [
                  ["fetch", "LoanApplication"],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "page-header",
                      "title": "Loan Applications",
                      "actions": [
                        {
                          "label": "New Application",
                          "event": "CREATE"
                        }
                      ]
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "entity-table",
                      "entity": "LoanApplication",
                      "fields": ["applicantName", "requestedAmount", "status", "createdAt"],
                      "itemActions": [
                        {
                          "label": "Review",
                          "event": "REVIEW"
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "from": "listing",
                "to": "creating",
                "event": "CREATE",
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "LoanApplication",
                      "fields": ["applicantName", "email", "requestedAmount", "annualIncome", "creditScore", "employmentYears", "existingDebt"],
                      "onSubmit": "SAVE",
                      "onCancel": "BACK"
                    }
                  ]
                ]
              },
              {
                "from": "creating",
                "to": "listing",
                "event": "SAVE",
                "guard": [
                  "and",
                  ["!=", "@payload.data.applicantName", ""],
                  [">", "@payload.data.requestedAmount", 0],
                  ["<=", "@payload.data.requestedAmount", 1000000],
                  [">", "@payload.data.annualIncome", 0],
                  [">=", "@payload.data.creditScore", 300],
                  ["<=", "@payload.data.creditScore", 850],
                  [">=", "@payload.data.employmentYears", 0]
                ],
                "effects": [
                  ["persist", "create", "LoanApplication", "@payload.data"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Application saved", "dismissible": true}],
                  ["emit", "INIT"]
                ]
              },
              {
                "from": "creating",
                "to": "listing",
                "event": "BACK",
                "effects": [
                  ["emit", "INIT"]
                ]
              },
              {
                "from": "listing",
                "to": "reviewing",
                "event": "REVIEW",
                "effects": [
                  ["fetch", "LoanApplication", {"id": "@payload.row.id"}],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "LoanApplication",
                      "entityId": "@payload.row.id",
                      "fields": ["applicantName", "email", "requestedAmount", "annualIncome", "creditScore", "employmentYears", "existingDebt", "status"],
                      "onSubmit": "SUBMIT",
                      "onCancel": "BACK"
                    }
                  ]
                ]
              },
              {
                "from": "reviewing",
                "to": "listing",
                "event": "BACK",
                "effects": [
                  ["emit", "INIT"]
                ]
              },
              {
                "from": "reviewing",
                "to": "reviewing",
                "event": "SUBMIT",
                "guard": ["=", "@entity.status", "draft"],
                "effects": [
                  ["persist", "update", "LoanApplication", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "info", "message": "Application submitted for processing", "dismissible": true}]
                ]
              },
              {
                "from": "reviewing",
                "to": "reviewing",
                "event": "AUTO_APPROVE",
                "guard": [
                  "and",
                  ["=", "@entity.status", "submitted"],
                  [">=", "@entity.creditScore", 750],
                  [">=", "@entity.employmentYears", 2],
                  ["<=", "@entity.existingDebt", ["*", "@entity.annualIncome", 0.3]],
                  ["<=", "@entity.requestedAmount", ["*", "@entity.annualIncome", 3]]
                ],
                "effects": [
                  ["persist", "update", "LoanApplication", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Application auto-approved", "dismissible": true}]
                ]
              },
              {
                "from": "reviewing",
                "to": "reviewing",
                "event": "AUTO_REJECT",
                "guard": [
                  "and",
                  ["=", "@entity.status", "submitted"],
                  [
                    "or",
                    ["<", "@entity.creditScore", 500],
                    [">", "@entity.existingDebt", ["*", "@entity.annualIncome", 0.5]],
                    [">", "@entity.requestedAmount", ["*", "@entity.annualIncome", 5]]
                  ]
                ],
                "effects": [
                  ["persist", "update", "LoanApplication", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "warning", "message": "Application auto-rejected", "dismissible": true}]
                ]
              },
              {
                "from": "reviewing",
                "to": "deciding",
                "event": "MANUAL_APPROVE",
                "guard": [
                  "and",
                  ["=", "@entity.status", "submitted"],
                  [
                    "not",
                    [
                      "or",
                      [
                        "and",
                        [">=", "@entity.creditScore", 750],
                        [">=", "@entity.employmentYears", 2]
                      ],
                      ["<", "@entity.creditScore", 500]
                    ]
                  ]
                ],
                "effects": [
                  [
                    "render-ui",
                    "modal",
                    {
                      "type": "form-section",
                      "title": "Approve Application",
                      "fields": [
                        {"name": "approvedAmount", "type": "number", "label": "Approved Amount"},
                        {"name": "interestRate", "type": "number", "label": "Interest Rate (%)"},
                        {"name": "reviewNotes", "type": "string", "label": "Notes"}
                      ],
                      "initialData": {
                        "approvedAmount": "@entity.requestedAmount"
                      },
                      "onSubmit": "SAVE",
                      "onCancel": "CANCEL"
                    }
                  ]
                ]
              },
              {
                "from": "deciding",
                "to": "reviewing",
                "event": "SAVE",
                "guard": [
                  "and",
                  [">", "@payload.data.approvedAmount", 0],
                  ["<=", "@payload.data.approvedAmount", "@entity.requestedAmount"],
                  [">", "@payload.data.interestRate", 0],
                  ["<=", "@payload.data.interestRate", 30]
                ],
                "effects": [
                  ["persist", "update", "LoanApplication", "@payload.id"],
                  ["render-ui", "modal", null],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Application approved", "dismissible": true}],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "LoanApplication",
                      "fields": ["applicantName", "email", "requestedAmount", "annualIncome", "creditScore", "employmentYears", "existingDebt", "status"],
                      "onSubmit": "SUBMIT",
                      "onCancel": "BACK"
                    }
                  ]
                ]
              },
              {
                "from": "deciding",
                "to": "reviewing",
                "event": "CANCEL",
                "effects": [
                  ["render-ui", "modal", null],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "LoanApplication",
                      "fields": ["applicantName", "email", "requestedAmount", "annualIncome", "creditScore", "employmentYears", "existingDebt", "status"],
                      "onSubmit": "SUBMIT",
                      "onCancel": "BACK"
                    }
                  ]
                ]
              },
              {
                "from": "deciding",
                "to": "reviewing",
                "event": "BACK",
                "effects": [
                  ["render-ui", "modal", null],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "LoanApplication",
                      "fields": ["applicantName", "email", "requestedAmount", "annualIncome", "creditScore", "employmentYears", "existingDebt", "status"],
                      "onSubmit": "SUBMIT",
                      "onCancel": "BACK"
                    }
                  ]
                ]
              },
              {
                "from": "reviewing",
                "to": "reviewing",
                "event": "MANUAL_REJECT",
                "guard": ["=", "@entity.status", "submitted"],
                "effects": [
                  [
                    "render-ui",
                    "modal",
                    {
                      "type": "form-section",
                      "title": "Reject Application",
                      "fields": [
                        {"name": "rejectionReason", "type": "string", "label": "Rejection Reason"}
                      ],
                      "onSubmit": "SAVE",
                      "onCancel": "CANCEL"
                    }
                  ]
                ]
              },
              {
                "from": "reviewing",
                "to": "listing",
                "event": "CANCEL",
                "effects": [
                  ["render-ui", "modal", null],
                  ["emit", "INIT"],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "page-header",
                      "title": "Loan Applications",
                      "actions": [
                        {
                          "label": "New Application",
                          "event": "CREATE"
                        }
                      ]
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "entity-table",
                      "entity": "LoanApplication",
                      "fields": ["applicantName", "requestedAmount", "status", "createdAt"],
                      "itemActions": [
                        {
                          "label": "Review",
                          "event": "REVIEW"
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "from": "reviewing",
                "to": "reviewing",
                "event": "DISBURSE",
                "guard": [
                  "and",
                  ["=", "@entity.status", "approved"],
                  [">", "@entity.approvedAmount", 0]
                ],
                "effects": [
                  ["persist", "update", "LoanApplication", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Funds disbursed successfully", "dismissible": true}]
                ]
              }
            ]
          }
        }
      ],
      "pages": [
        {
          "name": "LoanApplicationsPage",
          "path": "/loans",
          "viewType": "list",
          "primaryEntity": "LoanApplication",
          "isInitial": true,
          "traits": [
            {
              "ref": "LoanProcessing"
            }
          ]
        }
      ]
    }
  ]
}
