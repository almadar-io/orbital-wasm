{
  "name": "parse-guards",
  "orbitals": [
    {
      "name": "O",
      "entity": {
        "name": "Thing",
        "persistence": "runtime",
        "fields": [
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "title",
            "type": "string"
          }
        ]
      },
      "types": {
        "Item": [
          {
            "name": "name",
            "type": "string"
          }
        ],
        "Pending": [
          {
            "name": "key",
            "type": "string"
          },
          {
            "name": "size",
            "type": "number"
          },
          {
            "name": "isPublic",
            "type": "boolean"
          },
          {
            "name": "mode",
            "type": "string"
          }
        ],
        "Batch": [
          {
            "name": "items",
            "type": "[Item]"
          },
          {
            "name": "idx",
            "type": "number"
          }
        ]
      },
      "traits": [
        {
          "name": "Saver",
          "linkedEntity": "Thing",
          "stateMachine": {
            "states": [
              {
                "name": "idle",
                "isInitial": true
              }
            ],
            "events": [
              {
                "key": "DONE",
                "name": "DONE",
                "payloadSchema": [
                  {
                    "name": "state",
                    "type": "string",
                    "required": true
                  }
                ]
              },
              {
                "key": "NEXT",
                "name": "NEXT",
                "payloadSchema": [
                  {
                    "name": "batch",
                    "type": "string",
                    "required": true
                  }
                ]
              },
              {
                "key": "LOADED",
                "name": "LOADED",
                "payloadSchema": [
                  {
                    "name": "data",
                    "type": "[Thing]"
                  }
                ]
              }
            ],
            "transitions": [
              {
                "from": "idle",
                "to": "idle",
                "event": "INIT"
              },
              {
                "from": "idle",
                "to": "idle",
                "event": "DONE",
                "guard": [
                  "=",
                  [
                    "object/get",
                    [
                      "json/parse",
                      "@payload.state",
                      "Pending"
                    ],
                    "mode",
                    "single"
                  ],
                  "single"
                ]
              },
              {
                "from": "idle",
                "to": "idle",
                "event": "DONE",
                "guard": [
                  "=",
                  [
                    "object/get",
                    [
                      "json/parse",
                      "@payload.state",
                      "Pending"
                    ],
                    "mode",
                    "single"
                  ],
                  "batch"
                ]
              },
              {
                "from": "idle",
                "to": "idle",
                "event": "NEXT",
                "guard": [
                  "<",
                  [
                    "object/get",
                    [
                      "json/parse",
                      "@payload.batch",
                      "Batch"
                    ],
                    "idx",
                    0
                  ],
                  [
                    "array/len",
                    [
                      "object/get",
                      [
                        "json/parse",
                        "@payload.batch",
                        "Batch"
                      ],
                      "items",
                      []
                    ]
                  ]
                ]
              },
              {
                "from": "idle",
                "to": "idle",
                "event": "LOADED",
                "guard": [
                  ">",
                  [
                    "array/len",
                    "@payload.data"
                  ],
                  0
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}