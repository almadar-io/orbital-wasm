{
  "name": "State Machine Test",
  "description": "Complex state machine with transitions, guards, and effects",
  "version": "1.0.0",
  "orbitals": [
    {
      "name": "Order Processing",
      "entity": {
        "name": "Order",
        "collection": "orders",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "primaryKey": true
          },
          {
            "name": "customerName",
            "type": "string",
            "required": true
          },
          {
            "name": "items",
            "type": "array"
          },
          {
            "name": "total",
            "type": "number",
            "required": true
          },
          {
            "name": "status",
            "type": "enum",
            "values": ["draft", "submitted", "processing", "shipped", "delivered", "cancelled"],
            "default": "draft"
          },
          {
            "name": "shippingAddress",
            "type": "string"
          },
          {
            "name": "trackingNumber",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "timestamp",
            "default": "@now"
          },
          {
            "name": "submittedAt",
            "type": "timestamp"
          },
          {
            "name": "shippedAt",
            "type": "timestamp"
          },
          {
            "name": "deliveredAt",
            "type": "timestamp"
          }
        ]
      },
      "traits": [
        {
          "name": "OrderLifecycle",
          "category": "lifecycle",
          "linkedEntity": "Order",
          "emits": [
            { "event": "INIT", "scope": "internal" },
            { "event": "VIEW", "scope": "internal" }
          ],
          "stateMachine": {
            "states": [
              {
                "name": "listing",
                "isInitial": true
              },
              {
                "name": "viewing"
              },
              {
                "name": "creating"
              },
              {
                "name": "editing"
              }
            ],
            "events": [
              {
                "key": "INIT",
                "name": "Initialize"
              },
              {
                "key": "VIEW",
                "name": "View Order",
                "payload": [
                  { "name": "row", "type": "Order" }
                ]
              },
              {
                "key": "CREATE",
                "name": "Create Order"
              },
              {
                "key": "EDIT",
                "name": "Edit Order",
                "payload": [
                  { "name": "row", "type": "Order" }
                ]
              },
              {
                "key": "SAVE",
                "name": "Save",
                "payload": [
                  { "name": "id", "type": "string" },
                  { "name": "data", "type": "Order" }
                ]
              },
              {
                "key": "SUBMIT",
                "name": "Submit Order",
                "payload": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "PROCESS",
                "name": "Start Processing",
                "payload": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "SHIP",
                "name": "Ship Order",
                "payload": [
                  { "name": "id", "type": "string" },
                  { "name": "trackingNumber", "type": "string" }
                ]
              },
              {
                "key": "DELIVER",
                "name": "Mark Delivered",
                "payload": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "CANCEL",
                "name": "Cancel",
                "payload": [
                  { "name": "id", "type": "string" }
                ]
              },
              {
                "key": "BACK",
                "name": "Back"
              }
            ],
            "transitions": [
              {
                "from": "listing",
                "to": "listing",
                "event": "INIT",
                "effects": [
                  ["fetch", "Order"],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "page-header",
                      "title": "Orders",
                      "actions": [
                        {
                          "label": "New Order",
                          "event": "CREATE"
                        }
                      ]
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "entity-table",
                      "entity": "Order",
                      "fields": ["customerName", "total", "status", "createdAt"],
                      "itemActions": [
                        {
                          "label": "View",
                          "event": "VIEW"
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "from": "listing",
                "to": "viewing",
                "event": "VIEW",
                "effects": [
                  ["fetch", "Order", {"id": "@payload.row.id"}],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "page-header",
                      "title": "Order Details",
                      "showBack": true,
                      "backEvent": "BACK",
                      "actions": [
                        {
                          "label": "Back",
                          "event": "BACK"
                        }
                      ]
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "detail-panel",
                      "entity": "Order",
                      "entityId": "@payload.row.id",
                      "fields": ["customerName", "items", "total", "status", "shippingAddress", "trackingNumber"],
                      "actions": ["EDIT", "BACK"]
                    }
                  ]
                ]
              },
              {
                "from": "viewing",
                "to": "listing",
                "event": "BACK",
                "effects": [
                  ["emit", "INIT"]
                ]
              },
              {
                "from": "listing",
                "to": "creating",
                "event": "CREATE",
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "page-header",
                      "title": "New Order",
                      "showBack": true,
                      "backEvent": "CANCEL"
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "Order",
                      "fields": ["customerName", "total", "shippingAddress"],
                      "onSubmit": "SAVE",
                      "onCancel": "CANCEL"
                    }
                  ]
                ]
              },
              {
                "from": "creating",
                "to": "listing",
                "event": "SAVE",
                "guard": [
                  "and",
                  ["!=", "@payload.data.customerName", ""],
                  [">", "@payload.data.total", 0]
                ],
                "effects": [
                  ["persist", "create", "Order", "@payload.data"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Order created successfully", "dismissible": true}],
                  ["emit", "INIT"]
                ]
              },
              {
                "from": "creating",
                "to": "listing",
                "event": "CANCEL",
                "effects": [
                  ["emit", "INIT"]
                ]
              },
              {
                "from": "viewing",
                "to": "editing",
                "event": "EDIT",
                "guard": [
                  "or",
                  ["=", "@entity.status", "draft"],
                  ["=", "@entity.status", "submitted"]
                ],
                "effects": [
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "page-header",
                      "title": "Edit Order",
                      "showBack": true,
                      "backEvent": "CANCEL"
                    }
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "form-section",
                      "entity": "Order",
                      "entityId": "@payload.row.id",
                      "fields": ["customerName", "total", "shippingAddress"],
                      "onSubmit": "SAVE",
                      "onCancel": "CANCEL"
                    }
                  ]
                ]
              },
              {
                "from": "editing",
                "to": "viewing",
                "event": "SAVE",
                "effects": [
                  ["persist", "update", "Order", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Order updated", "dismissible": true}],
                  ["emit", "VIEW"]
                ]
              },
              {
                "from": "editing",
                "to": "viewing",
                "event": "CANCEL",
                "effects": [
                  ["emit", "VIEW"]
                ]
              },
              {
                "from": "viewing",
                "to": "viewing",
                "event": "SUBMIT",
                "guard": ["=", "@entity.status", "draft"],
                "effects": [
                  ["persist", "update", "Order", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Order submitted for processing", "dismissible": true}],
                  ["fetch", "Order", {"id": "@payload.id"}]
                ]
              },
              {
                "from": "viewing",
                "to": "viewing",
                "event": "PROCESS",
                "guard": ["=", "@entity.status", "submitted"],
                "effects": [
                  ["persist", "update", "Order", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "info", "message": "Order is now being processed", "dismissible": true}]
                ]
              },
              {
                "from": "viewing",
                "to": "viewing",
                "event": "SHIP",
                "guard": [
                  "and",
                  ["=", "@entity.status", "processing"],
                  ["!=", "@payload.trackingNumber", ""]
                ],
                "effects": [
                  ["persist", "update", "Order", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Order shipped", "dismissible": true}]
                ]
              },
              {
                "from": "viewing",
                "to": "viewing",
                "event": "DELIVER",
                "guard": ["=", "@entity.status", "shipped"],
                "effects": [
                  ["persist", "update", "Order", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "success", "message": "Order marked as delivered", "dismissible": true}]
                ]
              },
              {
                "from": "viewing",
                "to": "listing",
                "event": "CANCEL",
                "guard": [
                  "or",
                  ["=", "@entity.status", "draft"],
                  ["=", "@entity.status", "submitted"]
                ],
                "effects": [
                  ["persist", "update", "Order", "@payload.id"],
                  ["render-ui", "toast", {"type": "alert", "variant": "warning", "message": "Order cancelled", "dismissible": true}],
                  ["emit", "INIT"]
                ]
              }
            ]
          }
        }
      ],
      "pages": [
        {
          "name": "OrdersPage",
          "path": "/orders",
          "viewType": "list",
          "primaryEntity": "Order",
          "isInitial": true,
          "traits": [
            {
              "ref": "OrderLifecycle"
            }
          ]
        }
      ]
    }
  ]
}
